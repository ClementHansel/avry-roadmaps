# Phase 2: Roadmap Service - Independent Microservice
FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y \
    gcc \
    postgresql-client \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

EXPOSE 8088
ENV PORT=8088

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD python -c "import os,requests; requests.get(f'http://localhost:{os.getenv(\"PORT\",\"8088\")}/health')" || exit 1

CMD ["python", "main.py"]
